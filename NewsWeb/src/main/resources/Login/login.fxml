<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane
        prefWidth="420"
        prefHeight="720"
        stylesheets="@css/login.css"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.controller.LoginController">

    <children>
        <VBox alignment="CENTER" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <StackPane>

            <VBox fx:id="loginForm" alignment="CENTER" spacing="14" maxWidth="320" styleClass="login-card">

                <Label text="BÁO MỚI" styleClass="app-title"/>
                <Label text="Đăng nhập để tiếp tục" styleClass="sub-title"/>

                <TextField fx:id="usernameField" promptText="Tên tài khoản" styleClass="input-field"/>

                <StackPane styleClass="password-wrapper">

                    <PasswordField fx:id="passwordField" promptText="Mật khẩu" styleClass="input-field"/>

                    <TextField fx:id="passwordTextField" promptText="Mật khẩu" styleClass="input-field" visible="false" managed="false"/>

                    <Button fx:id="togglePasswordBtn" text="👁" onAction="#togglePasswordVisibility" styleClass="eye-button" StackPane.alignment="CENTER_RIGHT"/>
                </StackPane>

                <Label fx:id="errorLabel" text="Sai tài khoản hoặc mật khẩu" visible="false" managed="false" styleClass="error-text"/>

                <HBox alignment="CENTER_LEFT">
                    <CheckBox fx:id="rememberCheckBox" text="Nhớ tài khoản"/>
                </HBox>

                <Button fx:id="loginButton" text="Đăng nhập" maxWidth="Infinity" onAction="#handleLogin" styleClass="login-button"/>

                <Hyperlink text="Quên mật khẩu?" onAction="#goToForgotPassword"/>

                <HBox alignment="CENTER" spacing="4">
                    <Label text="Chưa có tài khoản?"/>
                    <Hyperlink text="Đăng ký" onAction="#goToRegister"/>
                </HBox>
            </VBox>

            <VBox fx:id="autoLoginBox" alignment="CENTER" spacing="16" maxWidth="320" styleClass="login-card" visible="false" managed="false">

                <Label text="BÁO MỚI" styleClass="app-title"/>

                <Label fx:id="welcomeLabel" styleClass="sub-title"/>

                <Button text="Tiếp tục" maxWidth="Infinity" onAction="#handleContinue" styleClass="login-button"/>

                <Button text="Đăng nhập tài khoản khác" maxWidth="Infinity" onAction="#handleLoginOther"/>
            </VBox>

        </StackPane>
        </VBox>
    </children>
</AnchorPane>