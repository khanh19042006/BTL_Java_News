<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720" prefWidth="420" stylesheets="@css/forgot.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ForgotPasswordController">

    <children>
        <VBox alignment="CENTER" spacing="16" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <VBox alignment="CENTER" maxWidth="320" spacing="14" styleClass="login-card">

                <Label styleClass="app-title" text="BÁO MỚI" />
                <Label styleClass="sub-title" text="Quên mật khẩu" />
                <TextField fx:id="usernameField" promptText="Nhập username" styleClass="input-field" />
                <TextField fx:id="emailField" promptText="Nhập email đã đăng ký" styleClass="input-field" />

                <HBox alignment="CENTER" spacing="8">
                    <TextField fx:id="otpField" prefWidth="76.0" promptText="Nhập OTP" styleClass="input-field" HBox.hgrow="ALWAYS" />

                    <Button fx:id="sendOtpBtn" onAction="#handleSendOtp" styleClass="login-button" text="Gửi OTP"/>

                          <Button fx:id="resendBtn" onAction="#handleResendOtp" styleClass="login-button" text="Gửi lại" managed="false" visible="false" />

                    <Button fx:id="confirmOtpBtn" onAction="#handleConfirmOtp" prefWidth="76.0" styleClass="login-button" text="Xác nhận" managed="false" visible="false"  />
                </HBox>

                <PasswordField fx:id="newPasswordField" promptText="Mật khẩu mới" styleClass="input-field" />

                <Label fx:id="messageLabel" managed="false" styleClass="error-text" visible="false" />

                <Button maxWidth="Infinity" onAction="#handleResetPassword" styleClass="login-button" text="Đổi mật khẩu" />

                <HBox alignment="CENTER" spacing="4">
                    <Label text="Nhớ mật khẩu rồi?" />
                    <Hyperlink onAction="#goToLogin" text="Đăng nhập" />
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
