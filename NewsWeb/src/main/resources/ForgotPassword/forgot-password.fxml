<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720" prefWidth="420"
            stylesheets="@css/register.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.ForgotPasswordController">

    <children>
        <VBox alignment="CENTER" spacing="16"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              AnchorPane.topAnchor="0">

            <VBox alignment="CENTER"
                  maxWidth="320"
                  spacing="14"
                  styleClass="login-card">

                <Label styleClass="app-title" text="BÁO MỚI" />
                <Label styleClass="sub-title" text="Quên mật khẩu" />
                <TextField fx:id="usernameField"
                           promptText="Nhập username"
                           styleClass="input-field" />
                <TextField fx:id="emailField"
                           promptText="Nhập email đã đăng ký"
                           styleClass="input-field" />

                <HBox spacing="8" alignment="CENTER">
                    <TextField fx:id="otpField"
                               promptText="Nhập OTP"
                               styleClass="input-field"
                               HBox.hgrow="ALWAYS"/>

                    <Button fx:id="sendOtpBtn"
                            text="Gửi OTP"
                            onAction="#handleSendOtp"
                            styleClass="login-button"/>

                    <Button fx:id="resendBtn"
                            text="Gửi lại"
                            onAction="#handleResendOtp"
                            visible="false"
                            managed="false"
                            styleClass="login-button"/>

                    <Button fx:id="confirmOtpBtn"
                            text="Xác nhận"
                            onAction="#handleConfirmOtp"
                            visible="false"
                            managed="false"
                            styleClass="login-button"/>
                </HBox>

                <PasswordField fx:id="newPasswordField"
                               promptText="Mật khẩu mới"
                               styleClass="input-field" />

                <Label fx:id="messageLabel"
                       visible="false"
                       managed="false"
                       styleClass="error-text" />

                <Button maxWidth="Infinity"
                        onAction="#handleResetPassword"
                        styleClass="login-button"
                        text="Đổi mật khẩu" />

                <HBox alignment="CENTER" spacing="4">
                    <Label text="Nhớ mật khẩu rồi?" />
                    <Hyperlink onAction="#goToLogin"
                               text="Đăng nhập" />
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>